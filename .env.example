# Copy to .env for local scripts (e.g. scripts/seed-admin.js). Set the real
# values as Vercel Project → Settings → Environment Variables for deploys —
# this file is never read by Vercel itself, and .env is gitignored.

# Supabase pooled connection string (port 6543, pgbouncer transaction mode)
DATABASE_URL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Long random string — signs/verifies login JWTs
JWT_SECRET=

# Long random string — must match DEVICE_KEY in petallock_esp32.ino
DEVICE_API_KEY=
